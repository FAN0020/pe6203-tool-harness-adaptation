# Set these in your shell. The adapter never reads arbitrary credential stores.
# A .env file is NOT loaded automatically; source only a file you trust.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
# Optional: exact Node executable, otherwise `node` from PATH.
# MCPEVOL_NODE=/absolute/path/to/node
