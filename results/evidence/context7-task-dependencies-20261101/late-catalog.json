    {
      "name": "create_entities",
      "title": "Create Entities",
      "description": "Create multiple new entities in the knowledge graph",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the entity"
                },
                "entityType": {
                  "type": "string",
                  "description": "The type of the entity"
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "An array of observation contents associated with the entity"
                }
              },
              "required": [
                "name",
                "entityType",
                "observations"
              ],
              "additionalProperties": false
            }
          },
          "skipDuplicates": {
            "type": "boolean",
            "description": "Whether to skip entities that already exist by name. Defaults to true"
          },
          "mergeObservations": {
            "type": "boolean",
            "description": "Whether to merge new observations into existing entities with the same name. Defaults to false"
          },
          "updateEntityType": {
            "type": "boolean",
            "description": "Whether to update the entityType of existing entities with the same name. Defaults to false"
          }
        },
        "required": [
          "entities"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
