              "additionalProperties": false
            }
          },
          "skipDuplicates": {
            "type": "boolean",
            "description": "Whether to skip relations that already exist. Defaults to true"
          },
          "requireExistingEntities": {
            "type": "boolean",
            "description": "Whether to require that both relation endpoints already exist as entities. Defaults to false"
          }
        },
        "required": [
          "relations"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
