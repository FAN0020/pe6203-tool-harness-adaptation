# Offline course delivery builds and large local bundles
/submission/.build/
/submission/slides/
/submission/*.zip
/submission/evidence/*.tar.gz

# Uncompressed source snapshots can exceed GitHub's per-file limit.
# Keep local originals; commit lossless .tar.gz copies and their manifests.
/results/evidence/**/source-*.tar

# Local browser QA sessions; evidence copies are archived under results/evidence.
/.playwright-cli/
/output/playwright/

# Keep curated results/evidence/ compressed archives, manifests, verification scripts,
# reports/ and frozen experiment configurations eligible for commit.
