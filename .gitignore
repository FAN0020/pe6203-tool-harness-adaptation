# Experiment outputs and caches
/outputs/
/runs/
/artifacts/
.cache/
*.log

# Local scratch directories and interrupted-write files
/tmp/
/.tmp/
*.tmp
*.temp

# Local editor and operating-system files
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo

# Local benchmark runtime and unreleased experiment outputs
node_modules/
/results/raw/
/configs/local*.json
