{
  "schema_version": "1.0",
  "benchmark_commit": "888c779a0fe735f612ca62bdd1fdd7c9e6bf8701",
  "note": "Native stdio profiles; source reviewed for workspace configuration. Startup and tool-call evidence are separate. No aliases or external credential values are inferred.",
  "servers": {
    "fetcher-mcp": {
      "entry": "build/index.js",
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "{root}/.cache/playwright"
      }
    },
    "edgeone-pages-mcp": {
      "entry": "dist/index.js"
    },
    "@pimzino/agentic-tools-mcp": {
      "entry": "dist/index.js"
    },
    "@itseasy21/mcp-knowledge-graph": {
      "entry": "dist/index.js",
      "env": {
        "MEMORY_FILE_PATH": "{workspace}/knowledge.jsonl"
      }
    },
    "@modelcontextprotocol/server-memory": {
      "entry": "dist/index.js",
      "env": {
        "MEMORY_FILE_PATH": "{workspace}/memory.jsonl"
      }
    },
    "@modelcontextprotocol/server-sequential-thinking": {
      "entry": "dist/index.js"
    },
    "@modelcontextprotocol/server-filesystem": {
      "entry": "dist/index.js",
      "args": [
        "{workspace}"
      ]
    },
    "mcp-tasks": {
      "entry": "dist/index.js",
      "env": {
        "WORKSPACE_FOLDER_PATHS": "{workspace}",
        "SOURCES_PATH": "{workspace}/task-sources.json",
        "DEBUG": "false"
      }
    },
    "mcp-calculator": {
      "entry": "build/index.js"
    },
    "math-mcp": {
      "entry": "dist/index.js"
    },
    "mcp-ai-agent-guidelines": {
      "entry": "dist/index.js"
    },
    "@umengfe/mcp-server-chart": {
      "entry": "build/index.js"
    },
    "swiftipedia-mcp-server": {
      "entry": "dist/index.js"
    },
    "wikipedia-mcp": {
      "entry": "dist/index.js"
    },
    "ygocdb-mcp-server": {
      "entry": "dist/index.js",
      "env": {
        "TRANSPORT": "stdio"
      }
    },
    "@jinzcdev/leetcode-mcp-server": {
      "entry": "build/index.js",
      "args": [
        "--site",
        "global"
      ]
    },
    "@sylphlab/pdf-reader-mcp": {
      "entry": "dist/src/index.js",
      "env": {
        "NAPI_RS_NATIVE_LIBRARY_PATH": "{root}/.cache/mcpevol/runtime-native/canvas-darwin-arm64-0.1.96/skia.darwin-arm64.node"
      }
    },
    "slidev-mcp": {
      "entry": "dist/index.js",
      "env": {
        "PATH": "{root}/.cache/node-runtime/node_modules/node/bin:{root}/.cache/slidev-render-v1/node_modules/.bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "NPM_CONFIG_PREFIX": "{workspace}/.npm-global",
        "NPM_CONFIG_CACHE": "{workspace}/.npm-cache"
      }
    },
    "mcp-server-commands": {
      "entry": "build/index.js"
    },
    "mcp-weather-demo": {
      "entry": "build/index.js"
    },
    "12306-mcp": {
      "entry": "build/index.js"
    }
  }
}
